# Upstream two-line-element source. CelesTrak needs no API key.
TLE_URL=https://celestrak.org/NORAD/elements/gp.php?CATNR=25544&FORMAT=tle

# How long a fetched TLE is served before a refresh is attempted (2 hours).
TLE_CACHE_TTL_SECONDS=7200

# Hard ceiling: past this age a cached TLE is refused outright (72 hours).
TLE_HARD_EXPIRY_SECONDS=259200

# A TLE older than this logs a warning; SGP4 accuracy degrades past a few days.
TLE_STALE_WARNING_SECONDS=86400

# Timeout for a single upstream TLE fetch, in seconds.
TLE_FETCH_TIMEOUT_SECONDS=10

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

LOG_LEVEL=INFO
